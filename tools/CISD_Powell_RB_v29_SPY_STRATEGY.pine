// ════════════════════════════════════════════════════════════════════════════
//  STRATEGY BUILD — generated, do not hand-edit.
//  Identical to CISD_Powell_RB_v29_SPY.pine except: the indicator()
//  declaration is now strategy(), and the order block at the end is new.
//  Everything between is byte-identical to the indicator.
// ════════════════════════════════════════════════════════════════════════════
//@version=6
// ════════════════════════════════════════════════════════════════════════════
//  C I S D °  —  Powell Rejection-Block Model · v29  (Powell-pure · hardened)
//  CISD: sweep → displacement → close past the OPEN that initiated the opposing
//   delivery SERIES (cisdMinRun=2), read on the chart TF beneath the HTF arrays.
//  "Pauci sed electi"  —  few, but chosen
// ════════════════════════════════════════════════════════════════════════════
strategy("CISD° — Powell RB (SPY strategy)", "CISD° SPY-S", overlay = true, max_bars_back = 1000, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 100, commission_type = strategy.commission.cash_per_order, commission_value = 1.0, slippage = 1, use_bar_magnifier = true, calc_on_every_tick = false, process_orders_on_close = false)

// █ 1 ▸ RB TIMEFRAMES
gT        = "1 ▸ RB Timeframes"
